NODE_ENV=development
PORT=8787
APP_NAME=DLavie Platform API
API_BASE_URL=http://localhost:8787
STOREFRONT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Feature flags. Keep a feature disabled until all required credentials are configured.
ENABLE_COMMERCE=true
ENABLE_PAYMENTS=false
ENABLE_AI=false

# PostgreSQL. Use a managed PostgreSQL instance for production.
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_SSL_MODE=disable

# At least 32 random characters. Never expose this value to browsers.
ADMIN_API_KEY=

# Commerce runtime
ORDER_PREFIX=DLV
CART_TTL_DAYS=14
CHECKOUT_RATE_LIMIT_MAX=10

# Midtrans Snap. Set ENABLE_PAYMENTS=true only after real credentials are present.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
PAYMENT_EXPIRY_MINUTES=60

# AI runtime. Required only when ENABLE_AI=true.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
PRIMARY_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
FALLBACK_AI_PROVIDER=huggingface
HUGGINGFACE_API_KEY=
HUGGINGFACE_CHAT_MODEL=
ENABLE_RAG=true
RAG_CHUNK_TARGET_TOKENS=1000
RAG_CHUNK_OVERLAP_TOKENS=125
RAG_RETRIEVAL_MAX_RESULTS=5
RAG_SIMILARITY_THRESHOLD=0.72
ENABLE_MODEL_FALLBACK=true
ENABLE_USAGE_LOGGING=true

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
LOG_LEVEL=info
