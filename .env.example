NODE_ENV=development
PORT=8787
APP_NAME=DLavie Commerce API
API_BASE_URL=http://localhost:8787
STOREFRONT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Commerce feature flags. Keep payments and providers disabled until credentials are configured.
ENABLE_COMMERCE=true
ENABLE_PAYMENTS=false
ENABLE_DIGIFLAZZ=false
ENABLE_AI=false

# PostgreSQL. Use a managed PostgreSQL instance for production.
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_SSL_MODE=disable

# Independent random secrets with at least 32 characters. Never expose these to browsers.
ADMIN_API_KEY=
COMMERCE_SESSION_SECRET=

# Commerce runtime
ORDER_PREFIX=DLV
CART_TTL_DAYS=14
CHECKOUT_RATE_LIMIT_MAX=10

# Digiflazz. Sandbox activation uses DIGIFLAZZ_TESTING=true.
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com
DIGIFLAZZ_TESTING=true
DIGIFLAZZ_MARKUP_PERCENT=3
DIGIFLAZZ_MINIMUM_MARKUP_AMOUNT=500

# Midtrans Snap. Sandbox activation uses MIDTRANS_IS_PRODUCTION=false.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
PAYMENT_EXPIRY_MINUTES=60

# Provider modes must match:
# - Sandbox: MIDTRANS_IS_PRODUCTION=false and DIGIFLAZZ_TESTING=true
# - Production: MIDTRANS_IS_PRODUCTION=true and DIGIFLAZZ_TESTING=false

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
LOG_LEVEL=info
