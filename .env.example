# App
NEXT_PUBLIC_APP_URL="https://your-dlavie-domain.vercel.app"

# Supabase client keys
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# Admin emails, comma-separated
NEXT_PUBLIC_ADMIN_EMAILS="owner@example.com"

# Server-only. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Gemini AI
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Telegram Bot
# Create a token from @BotFather, then store the real token only in your hosting secrets/env dashboard.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
DLAVIE_ADMIN_IDS="123456789"
TELEGRAM_WEBHOOK_SECRET="YOUR_RANDOM_TELEGRAM_WEBHOOK_SECRET"
TELEGRAM_SETUP_KEY="YOUR_RANDOM_SETUP_KEY"
