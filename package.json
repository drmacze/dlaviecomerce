{
  "name": "@dlavie/workspace",
  "version": "1.0.0",
  "description": "DLavie monorepo workspace. The active Next.js app and backend API live in apps/www.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @dlavie/www dev",
    "build": "pnpm --filter @dlavie/www build",
    "start": "pnpm --filter @dlavie/www start",
    "typecheck": "pnpm --filter @dlavie/www typecheck",
    "lint": "pnpm --filter @dlavie/www lint",
    "test": "pnpm --filter @dlavie/www test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
