NODE_ENV=development
APP_NAME="DLavie Platform"

# Server-side commerce API. Never expose admin or payment provider secrets to this app.
COMMERCE_API_URL=http://localhost:8787

# At least 32 random characters. Store a unique value per environment in its secret manager.
# Rotating this value invalidates active cart and order browser sessions.
# Example command: openssl rand -base64 48
COMMERCE_SESSION_SECRET=

# Optional AI and account runtime
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
ADMIN_API_KEY=

PRIMARY_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

FALLBACK_AI_PROVIDER=huggingface
HUGGINGFACE_API_KEY=
HUGGINGFACE_CHAT_MODEL=
ENABLE_MODEL_FALLBACK=true
ENABLE_RAG=true
ENABLE_USAGE_LOGGING=true

RAG_CHUNK_TARGET_TOKENS=1000
RAG_CHUNK_OVERLAP_TOKENS=125
RAG_RETRIEVAL_MAX_RESULTS=5
RAG_SIMILARITY_THRESHOLD=0.72
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW="1 minute"
LOG_LEVEL=info
