NODE_ENV=development
APP_NAME="DLavie Platform"

# Default Vercel setup: connect a Neon resource to this project. The integration injects
# DATABASE_URL server-side. Never add NEXT_PUBLIC_ to database credentials.
DATABASE_URL=
DATABASE_SSL_MODE=require
DATABASE_POOL_MAX=1

# Optional override for a separately deployed Fastify API. Leave empty to run the
# commerce backend inside the Next.js Node.js runtime using DATABASE_URL above.
COMMERCE_API_URL=

# Use unique random values per environment and store them in the deployment secret manager.
# Rotating either value invalidates the corresponding active browser sessions.
COMMERCE_SESSION_SECRET=
ADMIN_SESSION_SECRET=

# Supabase is currently required only for admin operator sign-in. Only users with
# profiles.role = 'admin' can access the dashboard. Commerce records live in Neon.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
ADMIN_API_KEY=

# Payments remain disabled until real Midtrans sandbox credentials and webhook tests pass.
ENABLE_PAYMENTS=false
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
PAYMENT_EXPIRY_MINUTES=60

PRIMARY_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

FALLBACK_AI_PROVIDER=huggingface
HUGGINGFACE_API_KEY=
HUGGINGFACE_CHAT_MODEL=
ENABLE_MODEL_FALLBACK=true
ENABLE_RAG=true
ENABLE_USAGE_LOGGING=true

RAG_CHUNK_TARGET_TOKENS=1000
RAG_CHUNK_OVERLAP_TOKENS=125
RAG_RETRIEVAL_MAX_RESULTS=5
RAG_SIMILARITY_THRESHOLD=0.72
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW="1 minute"
LOG_LEVEL=info
